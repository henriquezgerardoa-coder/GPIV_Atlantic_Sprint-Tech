root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 4

[*.{css,scss,less}]
indent_style = space
indent_size = 4

[*.{html,htm,xml,vue}]
indent_style = space
indent_size = 4

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.md]
max_line_length = 100
indent_style = space
indent_size = 2

[.editorconfig]
indent_style = space
indent_size = 2