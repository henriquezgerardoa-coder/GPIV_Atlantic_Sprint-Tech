{
  "doctype-first": true,
  "doctype-html5": true,
  "html-lang-require": true,
  "charset-lowercase": true,
  "head-script-disabled": true,
  "attr-lowercase": true,
  "attr-value-double-quotes": true,
  "attr-unsafe-chars": true,
  "attr-required": ["img:alt", "form:action", "a:href"],
  "id-unique": true,
  "id-class-value": "dash",
  "class-pair-empty-name": true,
  "empty-tag-not-self-closed": true,
  "src-not-empty": true,
  "title-require": true,
  "alt-require": true,
  "tag-pair": true,
  "tag-self-close": true,
  "spec-char-escape": true,
  "no-control-character": true,
  "inline-style-disabled": true,
  "inline-script-disabled": false,
  "event-handler-require": false
}