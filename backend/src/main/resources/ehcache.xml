<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.ehcache.org/v3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.ehcache.org/v3
                           http://www.ehcache.org/schema/ehcache-core-3.10.xsd">

    <!-- Default Cache Configuration -->
    <cache alias="default">
        <resources>
            <heap unit="entries">1000</heap>
            <offheap unit="MB">10</offheap>
        </resources>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <listeners>
            <listener class="org.ehcache.event.CacheEventListenerFactory"
                     event-firing="asynchronous"
                     events="created,updated,expired,evicted,removed"/>
        </listeners>
    </cache>

    <!-- Empresa Cache -->
    <cache alias="com.gpiv.atlanticsprinttech.entities.dominio.Empresa">
        <resources>
            <heap unit="entries">500</heap>
            <offheap unit="MB">5</offheap>
        </resources>
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
    </cache>

    <!-- RadicacionSolicitud Cache -->
    <cache alias="com.gpiv.atlanticsprinttech.entities.dominio.RadicacionSolicitud">
        <resources>
            <heap unit="entries">300</heap>
            <offheap unit="MB">3</offheap>
        </resources>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
    </cache>

    <!-- Lote Cache -->
    <cache alias="com.gpiv.atlanticsprinttech.entities.dominio.Lote">
        <resources>
            <heap unit="entries">200</heap>
            <offheap unit="MB">2</offheap>
        </resources>
        <expiry>
            <ttl unit="minutes">45</ttl>
        </expiry>
    </cache>

    <!-- Usuario Cache -->
    <cache alias="com.gpiv.atlanticsprinttech.entities.dominio.Usuario">
        <resources>
            <heap unit="entries">100</heap>
            <offheap unit="MB">1</offheap>
        </resources>
        <expiry>
            <ttl unit="minutes">20</ttl>
        </expiry>
    </cache>

    <!-- Query Cache for frequent queries -->
    <cache alias="org.hibernate.cache.internal.QueryResultsRegion">
        <resources>
            <heap unit="entries">500</heap>
            <offheap unit="MB">8</offheap>
        </resources>
        <expiry>
            <ttl unit="minutes">10</ttl>
        </expiry>
    </cache>

</config>

